# TestPilot compose 环境（复制为 deploy/.env 后填写；.env 不入库）

# ---- 必填密钥 ----
PG_PASSWORD=change-me-pg
TP_JWT_SECRET=change-me-jwt
# 种子 admin 账号口令（必改！弱口令=任何拿到仓库的人可以 owner 登录接管全部租户）
TP_ADMIN_PASSWORD=change-me-admin
TP_COPILOT_API_KEY=
# Worker gRPC 认证令牌（Scheduler 与全部 Worker 必须一致；必填）
TP_WORKER_TOKEN=change-me-worker-token

# ---- Copilot ----
TP_COPILOT_PROVIDER=deepseek
TP_COPILOT_BASE_URL=
TP_COPILOT_MODEL=deepseek-v4-flash

# ---- Worker 扩缩 ----
WORKER_REPLICAS=2
STRESS_WORKER_REPLICAS=1

# ---- 治理 ----
TP_RETENTION_RUN_DAYS=0
# TP_REGISTRATION_ENABLED=true   # 开放公开注册（默认 false）

# ---- Scheduler 制品后端（local | s3；OSS S3 网关端点如 https://s3.oss-cn-shanghai.aliyuncs.com）----
# TP_ARTIFACT_BACKEND=local
# TP_S3_ENDPOINT=
# TP_S3_ACCESS_KEY=          # 敏感：仅 env/YAML，不注册 CLI flag
# TP_S3_SECRET_KEY=
# TP_S3_BUCKET=
# TP_S3_REGION=
# TP_S3_PREFIX=              # 键 = {prefix}{tenant_id}/{uri}
# TP_S3_PATH_STYLE=false     # 私有 MinIO 设 true

# ---- Scheduler 细化（可选；更多键见 deploy/scheduler.yaml.example）----
TP_LOG_FORMAT=json
# PG 生产连接池建议 20/5/30（0=驱动默认）
TP_DB_MAX_OPEN_CONNS=20
TP_DB_MAX_IDLE_CONNS=5
TP_DB_CONN_MAX_LIFETIME_MIN=30
# TP_JWT_EXPIRE_HOURS=24
# TP_BODY_LIMIT_MB=64

# ---- Worker 出口控制（SSRF；生产建议配置）----
# 逗号分隔 host 白名单（精确或 .后缀）；空 = 不限
TP_EGRESS_ALLOW=
# 1 = 解析目标后拦截私网/环回/链路本地地址
TP_EGRESS_BLOCK_PRIVATE=
# 1 = 沙箱必须 OS 级网络隔离（sandbox-exec/bwrap），无工具时拒绝执行（fail-closed）；
#     本地无 gVisor 等容器运行时则保持默认 0（尽力而为）
# TP_SANDBOX_REQUIRE_ISOLATION=1

# ---- Scheduler /metrics 抓取白名单（空=不限制，本地默认）----
# 逗号分隔 CIDR；生产配置 Prometheus 出口网段后，其余来源 403
# TP_METRICS_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16

# ---- 链路（默认 otlp → 内嵌 Jaeger；none 关闭）----
TP_OTEL_EXPORTER=otlp
