# TestPilot Copilot 配置示例（copilot.yaml）
# 优先级：显式 CLI > 环境变量 > .env > 本文件 > 内置默认。
# 使用：--config copilot.yaml | TP_COPILOT_CONFIG=copilot.yaml | ./copilot.yaml（自动发现）。
# 注意：api_key 不走 CLI（进程列表可见）；放本文件时建议 chmod 600。

provider: deepseek              # deepseek | openai_compatible
api_key: ""                     # 建议用 TP_COPILOT_API_KEY 或 copilot/.env
base_url: ""                    # 空 = provider 默认端点
model: deepseek-v4-flash
summarizer_model: ""            # 上下文压缩摘要器；空=同主模型
context_window: 64000           # 压缩阈值基准（fraction 0.7 触发）

scheduler_grpc: 127.0.0.1:9090  # CopilotToolService
scheduler_rest: http://127.0.0.1:8080  # 会话持久化 / /me 解析
http_addr: 0.0.0.0:8100         # 对外 SSE 服务
http_timeout: 15                # 调 Scheduler REST 超时（秒）

otel_exporter: ""               # "" 关闭 | stdout | otlp
otel_endpoint: 127.0.0.1:4317
