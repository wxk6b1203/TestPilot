# TestPilot Scheduler 配置示例（scheduler.yaml）
# 优先级：显式 flag > 环境变量(TP_*) > 本文件 > 内置默认。
# 使用：--config scheduler.yaml | TP_CONFIG=scheduler.yaml | ./scheduler.yaml（自动发现）。
# 键名即 flag 的 snake_case 形态（--http-addr ↔ http_addr ↔ TP_HTTP_ADDR）。

http_addr: ":8080"              # REST + 前端托管
grpc_addr: ":9090"              # gRPC（Worker/Copilot）
static_dir: ""                  # 前端 dist 托管目录（空=不托管）

# —— 存储 ——
db_path: testpilot.db           # SQLite 文件（db_dsn 为空时生效）
db_dsn: ""                      # 非空切 PostgreSQL：postgres://user:pass@host:5432/db?sslmode=disable
db_max_open_conns: 0            # 连接池（0=驱动默认；PG 生产建议 20/5/30）
db_max_idle_conns: 0
db_conn_max_lifetime_min: 0

# —— 认证 ——
jwt_secret: dev-secret-change-me  # 生产必改
jwt_expire_hours: 24
registration_enabled: false      # 公开注册（POST /auth/register）：注册即自建租户 owner；生产按需开启

# —— 日志 / 链路 ——
log_level: info                 # debug|info|warn|error
log_format: text                # text | json（生产）
otel_exporter: ""               # "" 关闭 | stdout | otlp
otel_endpoint: 127.0.0.1:4317

# —— 数据与产物 ——
artifact_dir: .data/artifacts   # 与 Worker artifact_dir 一致
retention_run_days: 0           # 0=永久
retention_interval_min: 60

# —— HTTP 调优 ——
body_limit_mb: 64               # OpenAPI 导入需要较大上限
read_timeout_sec: 0             # 0=不限（注意：SSE 长连接/慢速下载场景勿设小值）
write_timeout_sec: 0
idle_timeout_sec: 0

# —— Copilot ——
copilot_url: http://127.0.0.1:8100  # /copilot-api/* 反代目标（生产 compose 设 http://copilot:8100；空=关闭反代）

# —— 制品后端（local | s3）——
artifact_backend: local           # s3 = 对象存储（键 {s3_prefix}{tenant_id}/{uri}）
s3_endpoint: ""                   # 如 https://s3.oss-cn-shanghai.aliyuncs.com（OSS S3 网关；非 s3.{region}.aliyuncs.com）
s3_access_key: ""                 # 敏感：仅 env/YAML，不注册 CLI flag
s3_secret_key: ""                 # 敏感：同上
s3_bucket: ""
s3_region: ""
s3_prefix: ""                     # 可选：多实例共享 bucket 时区分
s3_use_ssl: true
s3_path_style: false              # true=path-style（私有 MinIO）；AWS/OSS 用 virtual-hosted
