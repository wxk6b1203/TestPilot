# 复制为 .env 并填入密钥；或用环境变量注入
TP_COPILOT_PROVIDER=deepseek            # registry key: deepseek / openai_compatible
TP_COPILOT_API_KEY=
TP_COPILOT_BASE_URL=                    # 空 = provider 默认（deepseek → api.deepseek.com）
TP_COPILOT_MODEL=deepseek-v4-flash
TP_COPILOT_SUMMARIZER_MODEL=            # 空 = 同主模型
# Prompt 模板文件路径；空 = 使用包内置 copilot/src/testpilot_copilot/prompts/ 下的模板
# system.md 支持占位符 {{schema}} / {{sdk_doc}}
TP_COPILOT_SYSTEM_PROMPT_FILE=
TP_COPILOT_SUMMARIZER_PROMPT_FILE=
TP_COPILOT_CONTEXT_WINDOW=64000
TP_SCHEDULER_GRPC=127.0.0.1:9090
TP_SCHEDULER_REST=http://127.0.0.1:8080
TP_COPILOT_ADDR=0.0.0.0:8100
TP_COPILOT_MODEL_TIMEOUT=120       # LLM 首 token/流式 token 间读超时（秒）；0=不限
TP_COPILOT_STREAM_IDLE_TIMEOUT=300 # SSE 空闲兜底（秒）；0=禁用
